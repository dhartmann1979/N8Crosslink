[Unit]
Description=N8 Crosslink – FRN · DMR · Zello Bridge (Die N8schicht)
Documentation=https://github.com/dhartmann1979/N8Crosslink
After=network-online.target md380-emu.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
# systemd-Watchdog: meldet sich die Bridge 60 s nicht (Event-Loop hängt), wird sie neu gestartet
WatchdogSec=60
TimeoutStartSec=90
User=n8crosslink
Group=n8crosslink
SupplementaryGroups=dialout
WorkingDirectory=/opt/n8crosslink
Environment=N8X_DB=/opt/n8crosslink/data/crosslink.db
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/n8crosslink/venv/bin/python -m n8crosslink
Restart=always
RestartSec=3
# Echtzeit-Audio: etwas höhere Priorität
Nice=-5
# Erlaubt Web-Ports unter 1024 (z. B. 80) ohne root-Rechte – nur dieses eine Recht
AmbientCapabilities=CAP_NET_BIND_SERVICE
# NoNewPrivileges bewusst aus: das Webinterface nutzt sudo, beschränkt auf die
# Befehle in /etc/sudoers.d/n8crosslink (Update, Neustarts, Dienste, Berechtigungen).
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/n8crosslink/data

[Install]
WantedBy=multi-user.target
